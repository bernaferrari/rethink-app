<resources>

    <!-- Base application theme. API-specific system-bar items live in values-v27 / values-v29. -->
    <style name="AppThemeInitialBase" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/rethinkLaunchSurface</item>
        <item name="android:colorPrimary">@color/rethinkLaunchSurface</item>
        <item name="android:colorPrimaryDark">@color/rethinkLaunchSurface</item>
        <item name="android:colorAccent">@color/rethinkLaunchAccent</item>
        <item name="android:colorBackground">@color/rethinkLaunchSurface</item>
        <item name="android:statusBarColor">@color/rethinkLaunchSurface</item>
        <item name="android:navigationBarColor">@color/rethinkLaunchSurface</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Attr bridge for vector drawables still using ?attr/... (see attrs.xml).
             stroke/primaryText flip in values-night so untinted Images stay legible. -->
        <item name="svgStrokeColor">@color/stroke</item>
        <item name="svgFillColor">@color/fill</item>
        <item name="primaryTextColor">@color/primaryText</item>
        <item name="background">@color/background</item>
        <item name="accentGood">@color/accentGood</item>
        <item name="chipTextPositive">@color/chipTextPositive</item>
        <item name="firewallNoRuleToggleBtnTxt">@color/firewallNoRuleToggleBtnTxt</item>
        <item name="firewallBlockToggleBtnTxt">@color/firewallBlockToggleBtnTxt</item>
        <item name="firewallBlockToggleBtnBg">@color/firewallBlockToggleBtnBg</item>
        <item name="firewallWhiteListToggleBtnTxt">@color/firewallWhiteListToggleBtnTxt</item>
        <item name="firewallWhiteListToggleBtnBg">@color/firewallWhiteListToggleBtnBg</item>
    </style>

    <style name="AppThemeInitial" parent="AppThemeInitialBase" />
</resources>
